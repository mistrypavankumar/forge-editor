{"nodes": [{"id": "docs_browser_component_inspector_inspector", "label": "Browser Component Inspector", "file_type": "document", "source_file": "docs/browser-component-inspector.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_browser_component_inspector_webview", "label": "Embedded webview guest panel", "file_type": "rationale", "source_file": "docs/browser-component-inspector.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A <webview> is a real DOM node so toolbar/inspector/overlay layer naturally within the React panel; WebContentsView floats above and fights the panel system, and an iframe is blocked by frame/CORS headers and can't run a preload. Runs with nodeIntegration off in an isolated persist:forge-browser partition."}, {"id": "docs_browser_component_inspector_main_world_script", "label": "Main-world inspector script", "file_type": "rationale", "source_file": "docs/browser-component-inspector.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React attaches its fiber to DOM nodes as __reactFiber$ expando properties only visible from the page's main world; an isolated-world preload cannot read them, so the sandboxed preload injects a self-contained main-world script bridged back via window.postMessage -> ipcRenderer.sendToHost."}, {"id": "docs_browser_component_inspector_resolve_and_open", "label": "resolveAndOpen source resolution", "file_type": "concept", "source_file": "docs/browser-component-inspector.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tries the strongest signal first: data-forge-* metadata -> fiber _debugSource -> component-name index -> Next.js route file -> fallback message."}], "edges": [{"source": "docs_browser_component_inspector_webview", "target"