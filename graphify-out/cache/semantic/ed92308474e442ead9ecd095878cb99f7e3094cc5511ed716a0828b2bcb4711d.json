{"nodes": [{"id": "specs_2026_06_26_forge_editor_integration_design_spec", "label": "Forge Editor Integration Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-26-forge-editor-integration-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_2026_06_26_forge_editor_integration_design_wait_mode", "label": "Blocking --wait Mode", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-26-forge-editor-integration-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EDITOR/VISUAL are blocking \u2014 git reads the file only after the editor process exits \u2014 so a --wait mode must stay alive until the specific file is closed. `open -aW` waits until Forge fully quits (wrong granularity), so per-file wait needs the CLI to talk to the running app over a socket. Phase 1 must NOT set EDITOR/VISUAL since it has no working --wait (would break git)."}, {"id": "specs_2026_06_26_forge_editor_integration_design_marked_block", "label": "Idempotent Shell-Profile Marked Block", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-26-forge-editor-integration-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Install rewrites the whole marked block; uninstall removes it; user content outside the markers is never touched \u2014 keeping reinstall idempotent."}, {"id": "specs_2026_06_26_forge_editor_integration_design_cli_shim", "label": "forge CLI Shim", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-26-forge-editor-integration-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installed to ~/.local/bin/forge (user-writable, no sudo). Absolute binary path baked in at install time; if Forge.app moves the user re-runs install."}], "edges": [{"source": "specs_2026_06_26_forge_editor_integration_design_wait_mode", "target": "specs_2026_06_26_forge_editor_integration_design_cli_shim", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-26-forge-editor-integration-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_06_26_forge_editor_integration_design_cli_shim", "target": "readme_forge_open_wrapper", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-26-forge-editor-integration-design.md", "source_location": null, "weight": 1.0}, {"source": "specs_2026_06_26_forge_editor_integration_design_spec", "target": "electron_builder_file_associations", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-06-26-forge-editor-integration-design.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "editor_integration_delivery", "label": "Editor integration (forge shim replacing wrapper)", "nodes": ["specs_2026_06_26_forge_editor_integration_design_spec", "plans_2026_06_26_forge_editor_integration_plan", "specs_2026_06_26_forge_editor_integration_design_cli_shim", "readme_forge_open_wrapper"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/specs/2026-06-26-forge-editor-integration-design.md"}]}